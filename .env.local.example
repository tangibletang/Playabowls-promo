# Copy this file to .env.local and fill in your values.
# Get KV credentials from: Vercel Dashboard → your project → Storage → KV → .env.local tab

KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_token_here

# Password to access /admin
ADMIN_PASSWORD=change_me_please

# Your deployed Vercel URL (no trailing slash) — used by scripts/generate-pdf.ts
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
