# Copy to .env.local and/or use: vercel env pull .env.development.local --environment=production
# REDIS_URL comes from Vercel → Project → Storage → Redis, or `vercel env pull`

REDIS_URL=rediss://default:password@host:port

# Password to access /admin
ADMIN_PASSWORD=change_me_please

# Deployed URL (no trailing slash) — QR links in generate-pdf.ts
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
